srcdir = @srcdir@
CC = @CC@
CFLAGS = @CFLAGS@ -I.
LDFLAGS = @LDFLAGS@
LIBS = @LIBS@
VERSION = @PACKAGE_VERSION@
VPATH = $(srcdir)

OBJ = attach.o master.o dch.o
SRC = $(srcdir)/attach.c $(srcdir)/master.c $(srcdir)/dch.c

TARFILES = $(srcdir)/README $(srcdir)/COPYING $(srcdir)/Makefile.in \
	   $(srcdir)/config.h.in $(SRC) \
	   $(srcdir)/dtach.h $(srcdir)/dtach.spec $(srcdir)/configure \
	   $(srcdir)/configure.ac $(srcdir)/dtach.1

dch: $(OBJ)
	$(CC) -o $@ $(LDFLAGS) $(OBJ) $(LIBS)

test: dch
	sh $(srcdir)/tests/run.sh

clean:
	rm -f dch $(OBJ) dch-$(VERSION).tar.gz

distclean: clean
	rm -f config.h Makefile config.log config.status config.cache

tar:
	mkdir dch-$(VERSION)
	cp $(TARFILES) dch-$(VERSION)
	tar -cf dch-$(VERSION).tar dch-$(VERSION)/
	gzip -9f dch-$(VERSION).tar
	rm -rf dch-$(VERSION)

attach.o: @srcdir@/attach.c @srcdir@/dtach.h config.h
master.o: @srcdir@/master.c @srcdir@/dtach.h config.h
dch.o: @srcdir@/dch.c @srcdir@/dtach.h config.h
