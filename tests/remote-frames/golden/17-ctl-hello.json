{
  "id": "17-ctl-hello",
  "about": "A server with the ctl op (dch serve 1.41+) speaks proto 1.1 or later and lists ctl among its ops.",
  "requires_op": "ctl",
  "steps": [
    {
      "send": "08 00000000"
    },
    {
      "expect": {
        "type": "18",
        "json": {
          "ops": [
            "string"
          ],
          "proto": "string~1\\.([1-9]|[0-9]{2,})"
        }
      }
    }
  ]
}
