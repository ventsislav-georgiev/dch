{
  "id": "41-ctl-cancel",
  "about": "0x34 mid-run (a --follow): the server ends the dch and sends 0x33 exit 2, why cancel. A 0x34 after that 0x33 is ignored, and the warm connection runs the next 0x30.",
  "requires_op": "ctl-cancel",
  "mutating": true,
  "dch_mirror": true,
  "steps": [
    {
      "send": "30 00000022 7b2261726776223a5b222d2d666f6c6c6f77222c22676f6c64656e2d313138225d7d"
    },
    {
      "expect": {
        "type": "31",
        "nonempty": true
      }
    },
    {
      "send": "34 00000000"
    },
    {
      "expect": {
        "type": "33",
        "payload": "7b2265786974223a322c22776879223a2263616e63656c227d"
      }
    },
    {
      "send": "34 00000000"
    },
    {
      "expect_quiet": 0.3
    },
    {
      "send": "30 00000022 7b2261726776223a5b222d2d737461747573222c22676f6c64656e2d313138225d7d"
    },
    {
      "expect": {
        "type": "31",
        "nonempty": true
      }
    },
    {
      "expect": {
        "type": "33",
        "payload": "7b2265786974223a307d"
      }
    }
  ]
}
